rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function staff(){ return signedIn() && (request.auth.token.email in ['akewusholaabdulbakri101@gmail.com','jennypandy49@gmail.com'] || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','owner']); }

  match /users/{uid} {
    allow read: if signedIn() && (request.auth.uid == uid || staff());
    allow create: if signedIn() && request.auth.uid == uid;
    allow update: if signedIn() && (request.auth.uid == uid && request.resource.data.role == resource.data.role || staff());
  }
  match /usernames/{username} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }
  match /stories/{id} {
    allow read: if resource.data.status == 'published' || staff();
    allow create,update,delete: if staff();
  }
  match /likes/{id} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    allow delete: if signedIn() && resource.data.userId == request.auth.uid;
  }
  match /bookmarks/{id} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    allow delete: if signedIn() && resource.data.userId == request.auth.uid;
  }
  match /story_analytics/{id} {
    allow read: if staff() || (signedIn() && resource.data.userId == request.auth.uid);
    allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
  }
  match /comments/{id} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    allow delete: if signedIn() && (resource.data.userId == request.auth.uid || staff());
  }
  match /messages/{id} {
    allow read,create: if signedIn();
    allow update,delete: if signedIn() && (resource.data.userId == request.auth.uid || staff());
  }
  match /chatMembers/{uid} {
    allow read: if signedIn();
    allow create,update: if signedIn() && request.auth.uid == uid;
  }
  match /notifications/{id} {
    allow read,update: if signedIn() && resource.data.userId == request.auth.uid;
    allow create: if staff();
  }
 }
}
